{
  "name": "platform",
  "version": "0.11.1",
  "private": true,
  "scripts": {
    "app": "docker compose -f infra/docker/docker-compose.yml up -d --build && node infra/launch/open-app.mjs",
    "dev": "docker compose -f infra/docker/docker-compose.yml up --build",
    "dev:clean": "docker compose -f infra/docker/docker-compose.yml down --volumes",
    "stop": "docker compose -f infra/docker/docker-compose.yml down",
    "icons": "node infra/icons/generate.mjs",
    "agents:sync": "sh infra/agents/sync.sh",
    "release:pack": "sh infra/release/pack.sh",
    "dev:local": "concurrently -n web,runner -c cyan,magenta \"npm:dev:web\" \"npm:dev:runner\"",
    "dev:container": "concurrently -n web,runner -c cyan,magenta \"next dev -H 0.0.0.0 -p 3001\" \"npm:dev:runner\"",
    "dev:web": "next dev -p 3001",
    "dev:runner": "tsx watch runner/server.ts",
    "build": "NODE_ENV=production next build",
    "start": "next start",
    "runner": "tsx runner/server.ts",
    "db:push": "sh infra/dev/run-script.sh drizzle-kit push",
    "db:generate": "sh infra/dev/run-script.sh drizzle-kit generate",
    "db:migrate": "sh infra/dev/run-script.sh tsx runner/migrate.ts",
    "cc:export": "sh infra/dev/run-script.sh tsx runner/export.ts",
    "cc:import": "sh infra/dev/run-script.sh tsx runner/import.ts",
    "db:backfill-titles": "sh infra/dev/run-script.sh tsx runner/backfill-titles.ts",
    "db:backfill-usage": "sh infra/dev/run-script.sh tsx runner/backfill-usage.ts",
    "lint": "eslint",
    "test": "tsx --test runner/*.test.ts lib/*.test.ts lib/discovery/*.test.ts infra/release/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.187",
    "@hono/node-server": "^2.0.6",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.2",
    "highlight.js": "11.11.2",
    "hono": "^4.12.27",
    "lowlight": "3.3.0",
    "lucide-react": "^1.21.0",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
