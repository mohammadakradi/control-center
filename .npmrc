# The installed app needs devDependencies to work at all, so never let a prod-only install happen.
#
# This is not a preference, it is a correctness requirement. `control-center` starts the runner
# with ./node_modules/.bin/tsx and builds with next + @tailwindcss/postcss — tsx, typescript,
# tailwindcss and @tailwindcss/postcss are all devDependencies. A tree installed without them
# cannot build AND cannot run.
#
# It has to live here, in the file pnpm reads from the project being installed, because of who
# runs the install. An in-app update is spawned by the running Next.js server
# (app/api/updates/apply/route.ts forwards `...process.env`), and that server is started with
# NODE_ENV=production — which pnpm reads as "skip devDependencies", says so, and exits 0. The
# build then dies on `Cannot find module '@tailwindcss/postcss'` and the update rolls back
# (reported 2026-09-07, updating 0.11.1 -> 0.12.0).
#
# `--prod=false` on the install commands in infra/release/{control-center,install}.sh fixes the
# same thing at the call site, but only from the *next* update onward: the script that performs
# an update is the OLD installed one. This file ships inside the tarball, so it is read by
# whatever updater unpacks it — which is what makes the fix reach installs already out there.
#
# npm (not pnpm) prints `npm warn config production Use \`--omit=dev\` instead.` on every npx
# call because it deprecated this key. IGNORE IT, and do NOT follow the suggestion: `omit=dev`
# means the opposite of what this line is for — it would drop devDependencies and reintroduce
# the exact failure. The warning is cosmetic; the behaviour it warns about is load-bearing.
#
# `production=false` specifically: `prod=false`, `dev=true` and `omit=` were all tested against
# pnpm 9.12.1 with NODE_ENV=production and do NOT override it. This one does.
production=false
