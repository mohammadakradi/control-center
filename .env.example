# Copy to .env (gitignored). Compose loads it from the repo root when you run `pnpm dev`.
#
# Auth for the Claude the runner spawns inside the container. Set exactly one.
# On macOS the host's Claude login lives in the Keychain, which does NOT cross into
# the Linux container via the ~/.claude bind-mount — so the container needs its own.

# Preferred: long-lived OAuth token tied to your subscription. Generate once with:
#   claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# Alternative: bill an API key instead of your subscription.
# ANTHROPIC_API_KEY=
